NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Comma-separated admin e-mails allowed to use protected endpoints (required).
# If empty, every admin endpoint returns 403.
ADMIN_EMAILS=admin@example.com

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (Nodemailer / Resend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=your@gmail.com

# GitHub activity widget (contribution calendar + recent commits)
# GITHUB_USERNAME defaults to the portfolio owner when omitted.
GITHUB_USERNAME=your_github_username
# Fine-grained personal access token, read-only, public repositories only.
# Without it the contribution calendar is unavailable (commits only).
GITHUB_TOKEN=
